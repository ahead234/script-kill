# 复制为 db.properties 后填写本机口令；该文件已被 .gitignore 排除，不要提交。
# 优先级：环境变量 > db.properties > 代码内默认值（见 util/Database.java）
#   DB_URL / DB_USERNAME / DB_PASSWORD / DB_DRIVER
# 容器部署只需在 docker-compose.yml 里设置环境变量，无需此文件。
db.url=jdbc:mysql://localhost:3306/script_booking?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
db.username=root
db.password=change_me
db.driver=com.mysql.cj.jdbc.Driver
